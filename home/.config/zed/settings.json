// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // UI
  "ssh_connections": [
    {
      "host": "cave-server",
      "args": [],
      "projects": [
        {
          "paths": ["/root"],
        },
      ],
    },
    {
      "host": "zeus",
      "args": [],
      "projects": [],
    },
  ],
  "cli_default_open_behavior": "new_window",
  "centered_layout": {
    "right_padding": 0.0,
    "left_padding": 0.0,
  },
  "soft_wrap": "editor_width",
  "minimap": {
    "max_width_columns": 80,
  },
  "terminal": {
    "shell": {
      "program": "/opt/homebrew/bin/fish",
    },
    "default_width": 640.0,
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.4",
      },
      "type": "registry",
    },
  },
  "diff_view_style": "unified",
  "buffer_font_family": "Zed Mono",
  "icon_theme": {
    "mode": "dark",
    "light": "Soft Charmed Icons",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "theme": {
    "mode": "system",
    "light": "Vercel Light",
    "dark": "Vercel Dark"
  },
  "tabs": {
    "file_icons": true,
  },
  // AI
  "edit_predictions": {
    "provider": "zed",
  },
  "agent": {
    "use_modifier_to_send": false,
    "notify_when_agent_waiting": "all_screens",
    "show_turn_stats": true,
    "play_sound_when_agent_done": "when_hidden",
    "dock": "left",
    "model_parameters": [],
  },
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
  },
  "project_panel": {
    "hide_hidden": false,
    "file_icons": true,
    "dock": "right",
  },
  "relative_line_numbers": "enabled",
  "ui_font_size": 14,
  "buffer_font_size": 12,
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "never",
  },
  "format_on_save": "on",
  "languages": {
    "TypeScript": {
      "language_servers": ["angular", "..."],
    },
    "HTML": {
      "language_servers": ["angular", "..."],
    },
  },
  "lsp": {
    "angular": {
      "initialization_options": {
        "angular_language_server_version": "18.0.0",
        "typescript_version": "5.5.2",
      },
    },
  },
}
